  sortOrder        Int               @default(9999) @map("sort_order")
  notes            String?           @db.VarChar(5000)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)
  operatingSystems OperatingSystem[]

  @@map("operating_system_vendors")
}

model OperatingSystem {
  id              Int       @id @default(autoincrement())
  vendorId        Int       @map("vendor_id")
  product         String
  version         String
  edition         String?
  architecture    String?
  notes           String?   @db.VarChar(5000)
  officialUrl     String?   @map("official_url")
  sourceCheckedOn DateTime? @map("source_checked_on") @db.Date
  sortOrder       Int       @default(9999) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  assets          ItAsset[]
  vendor          OperatingSystemVendor @relation(fields: [vendorId], references: [id])

  // m0012 creates this natural key with NULLS NOT DISTINCT for optional fields.
  @@unique([vendorId, product, version, edition, architecture], map: "operating_systems_natural_key")
  @@index([vendorId])
  @@map("operating_systems")
}

