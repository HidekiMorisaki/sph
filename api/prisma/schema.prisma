model BookTitle {
  id           Int               @id @default(autoincrement())
  catalogCode  String            @unique @map("catalog_code") @db.VarChar(40)
  name         String            @db.VarChar(500)
  author       String?           @db.VarChar(500)
  publisher    String?           @db.VarChar(255)
  edition      String?           @db.VarChar(100)
  /// Canonical ISBN-13. Active-row uniqueness and validation are enforced by m0030 SQL.
  isbn         String?           @db.VarChar(13)
  sourceProvider String?          @map("source_provider") @db.VarChar(40)
  sourceUrl     String?           @map("source_url") @db.VarChar(500)
  sourceRetrievedAt DateTime?     @map("source_retrieved_at") @db.Timestamptz(3)
  notes        String?
  coverImage   Bytes?            @map("cover_image") @db.ByteA
  coverSource  String?            @map("cover_source") @db.VarChar(20)
  coverSourceUrl String?          @map("cover_source_url") @db.VarChar(500)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(3)
  copies       BookCopy[]
  reservations BookReservation[]
  purchaseRequests BookPurchaseRequest[]
  purchaseOrders BookPurchaseOrder[]

  @@index([isbn])
  @@map("book_titles")
}

model BookCopy {
  id          Int            @id @default(autoincrement())
  copyCode    String         @unique @map("copy_code") @db.VarChar(40)
  titleId     Int            @map("title_id")
  storageId   Int            @map("storage_id")
  batchId     Int?           @map("batch_id")
  purchaseOrderId Int?       @map("purchase_order_id")
  purchasedOn DateTime?      @map("purchased_on") @db.Date
  status      String         @default("available") @db.VarChar(20)
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)
  title       BookTitle      @relation(fields: [titleId], references: [id], onDelete: Restrict)
  storage     Storage        @relation(fields: [storageId], references: [id], onDelete: Restrict)
  batch       BookCopyBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  purchaseOrder BookPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  loans       BookLoan[]

  @@index([titleId])
  @@index([storageId])
  @@map("book_copies")
}

model BookPurchaseRequest {
  id Int @id @default(autoincrement())
  requestCode String @unique @default(dbgenerated("gen_random_uuid()::text")) @map("request_code") @db.VarChar(40)
  titleId Int @map("title_id")
  branchId Int @map("branch_id")
  employeeId Int @map("employee_id")
  orderId Int? @map("order_id")
  kind String @db.VarChar(20)
  quantity Int
  reason String?
  status String @default("pending") @db.VarChar(20)
  decisionReason String? @map("decision_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  title BookTitle @relation(fields: [titleId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  order BookPurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([branchId, titleId, status])
  @@map("book_purchase_requests")
}

model BookPurchaseOrder {
  id Int @id @default(autoincrement())
  orderCode String @unique @default(dbgenerated("gen_random_uuid()::text")) @map("order_code") @db.VarChar(40)
  titleId Int @map("title_id")
  branchId Int @map("branch_id")
  quantity Int
  status String @default("approved") @db.VarChar(20)
  decisionReason String? @map("decision_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  title BookTitle @relation(fields: [titleId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requests BookPurchaseRequest[]
  copies BookCopy[]
  @@index([branchId, titleId, status])
  @@map("book_purchase_orders")
}

model BookCopyBatch {
  id         Int        @id @default(autoincrement())
  requestKey String     @unique @map("request_key") @db.VarChar(100)
  actorId    Int        @map("actor_id")
  bodyHash   String     @map("body_hash") @db.VarChar(64)
  result     Json?      @db.JsonB
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(3)
  actor      Employee   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  copies     BookCopy[]

  @@map("book_copy_batches")
}

model BookReservation {
  id              Int       @id @default(autoincrement())
  reservationCode String    @unique @map("reservation_code") @db.VarChar(40)
  titleId         Int       @map("title_id")
  employeeId      Int       @map("employee_id")
  branchId        Int       @map("branch_id")
  status          String    @default("waiting") @db.VarChar(20)
  reservedAt      DateTime  @default(now()) @map("reserved_at") @db.Timestamptz(3)
  expiresOn       DateTime? @map("expires_on") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  title           BookTitle @relation(fields: [titleId], references: [id], onDelete: Restrict)
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([titleId, branchId, reservedAt])
  @@map("book_reservations")
}

model BookLoan {
  id         Int       @id @default(autoincrement())
  loanCode   String    @unique @map("loan_code") @db.VarChar(40)
  copyId     Int       @map("copy_id")
  employeeId Int       @map("employee_id")
  managerId  Int       @map("manager_id")
  loanedOn   DateTime  @map("loaned_on") @db.Date
  dueOn      DateTime  @map("due_on") @db.Date
  returnedOn DateTime? @map("returned_on") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  copy       BookCopy  @relation(fields: [copyId], references: [id], onDelete: Restrict)
  employee   Employee  @relation("BookBorrower", fields: [employeeId], references: [id], onDelete: Restrict)
  manager    Employee  @relation("BookLoanManager", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([employeeId, dueOn])
  @@map("book_loans")
}

model BookChangeHistory {
