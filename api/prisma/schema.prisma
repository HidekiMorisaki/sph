model AccountInvitation {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @unique @map("token_hash")
  employeeId   Int       @map("employee_id")
  issuedById   Int       @map("issued_by_id")
  emailAtIssue String    @map("email_at_issue")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  employee     Employee  @relation("InvitationRecipient", fields: [employeeId], references: [id], onDelete: Restrict)
  issuedBy     Employee  @relation("InvitationIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt])
  @@index([issuedById])
  @@index([expiresAt])
  @@map("account_invitations")
}
