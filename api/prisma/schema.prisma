generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  unprovisioned
  active
  suspended
}

enum DisposalDatePolicy {
  prohibited
  optional
  required
}

model Employee {
  savedSearchFilters SavedSearchFilter[]
  skills EmployeeSkill[]
  projectParticipations ProjectParticipation[]
  workforceHistory WorkforceChangeHistory[] @relation("WorkforceSubject")
  workforceActions WorkforceChangeHistory[] @relation("WorkforceActor")
  id                      Int                     @id @default(autoincrement())
  employeeCode            String                  @unique @map("employee_code")
  firstName               String                  @map("first_name")
  middleName              String?                 @map("middle_name")
  lastName                String                  @map("last_name")
  nameKana                String?                 @map("name_kana")
  birthDate               DateTime                @map("birth_date") @db.Date
  /// Migrations m0013 and m0014 reject blank values and allow only female, male, or unspecified.
  gender                  String
  bloodType               String?                 @map("blood_type")
  countryCode             String                  @default("JP") @map("country_code") @db.VarChar(2)
  postalCode              String?                 @map("postal_code") @db.VarChar(10)
  prefecture              String?                 @db.VarChar(64)
  city                    String?                 @db.VarChar(128)
  streetAddress           String?                 @map("street_address") @db.VarChar(255)
  buildingName            String?                 @map("building_name") @db.VarChar(255)
  mobilePhone             String?                 @map("mobile_phone")
  email                   String                  @unique
  hiredAt                 DateTime                @map("hired_at") @db.Date
  groupId                 Int?                    @map("group_id")
  employmentTypeId        Int                     @map("employment_type_id")
  branchId                Int                     @map("branch_id")
  workCalendarId          Int?                    @map("work_calendar_id")
  retiredAt               DateTime?               @map("retired_at") @db.Date
  notes                   String?
  username                String?                 @unique
  passwordHash            String?                 @map("password_hash")
  accountStatus           AccountStatus           @default(unprovisioned) @map("account_status")
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?               @map("deleted_at") @db.Timestamptz(3)
  itAssetAssignments      ItAssetAssignment[]
  softwareAssignments     SoftwareAssignment[]
  softwareUsageRecords    SoftwareInstallationUser[]
  itAssetChangeHistory    ItAssetChangeHistory[]
  employeeChangeHistory   EmployeeChangeHistory[] @relation("EmployeeHistorySubject")
  recordedEmployeeChanges EmployeeChangeHistory[] @relation("EmployeeHistoryActor")
  accountInvitations      AccountInvitation[]     @relation("InvitationRecipient")
  issuedInvitations       AccountInvitation[]     @relation("InvitationIssuer")
  sessions                Session[]
  settings                EmployeeSettings?
  socialLinks             EmployeeSocialLink[]
  avatar                  EmployeeAvatar?
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  bookCopyBatches         BookCopyBatch[]
  bookPurchaseRequests    BookPurchaseRequest[]
  bookChangesRecorded     BookChangeHistory[]
  bookReservations        BookReservation[]
  bookLoans               BookLoan[]                @relation("BookBorrower")
  bookLoansManaged        BookLoan[]                @relation("BookLoanManager")
  widgets                 EmployeeWidget[]
  masterChangeHistory     MasterChangeHistory[]
  softwareChangesRecorded SoftwareChangeHistory[]
  roleGrants              EmployeeRole[]          @relation("Grantee")
  departmentAssignments   EmployeeDepartment[]
  teamAssignments         EmployeeTeam[]
  positionAssignments     EmployeePosition[]
  scopedGrants            EmployeeRole[]          @relation("ScopeEmployee")
  managedBranches         Branch[]                @relation("BranchManager")
  deputyManagedBranches   Branch[]                @relation("BranchDeputyManager")
  group                   EmployeeGroup?          @relation(fields: [groupId], references: [id])
  employmentType          EmploymentType          @relation(fields: [employmentTypeId], references: [id], onDelete: Restrict)
  branch                  Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  workCalendar            WorkCalendar?           @relation(fields: [workCalendarId], references: [id], onDelete: Restrict)

  @@index([workCalendarId])
  @@map("employees")
}

model SavedSearchFilter {
  id              Int      @id @default(autoincrement())
  ownerEmployeeId Int      @map("owner_employee_id")
  target          String   @db.VarChar(16)
  name            String   @db.VarChar(100)
  filterCode      String   @unique @default(dbgenerated("gen_random_uuid()")) @map("filter_code") @db.Uuid
  definition      Json     @db.JsonB
  schemaVersion   Int      @default(1) @map("schema_version")
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  owner           Employee @relation(fields: [ownerEmployeeId], references: [id], onDelete: Restrict)

  @@index([ownerEmployeeId, target, deletedAt])
  @@map("saved_search_filters")
}

model EmployeeAvatar {
  id         Int       @id @default(autoincrement())
  employeeId Int       @unique @map("employee_id")
  image      Bytes     @db.ByteA
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("employee_avatars")
}

model EmployeeSettings {
  id                 Int       @id @default(autoincrement())
  employeeId         Int       @unique @map("employee_id")
  timeZone           String    @default("Asia/Tokyo") @map("time_zone") @db.VarChar(64)
  displayLanguage    String    @default("en") @map("display_language") @db.VarChar(64)
  displayCurrency    String    @default("USD") @map("display_currency") @db.VarChar(3)
  analyticsSelection Json?     @map("analytics_selection") @db.JsonB
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("employee_settings")
}

model EmployeeSocialLink {
  id         Int       @id @default(autoincrement())
  linkKey    String    @unique @default(dbgenerated("gen_random_uuid()")) @map("link_key") @db.Uuid
  employeeId Int       @map("employee_id")
  platform   String    @db.VarChar(32)
  url        String    @db.VarChar(2048)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, platform])
  @@index([employeeId, deletedAt])
  @@map("employee_social_links")
}

model ExternalLink {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(128)
  notes     String?   @db.VarChar(5000)
  url       String    @db.VarChar(2048)
  sortOrder Int       @default(9999) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([sortOrder, name])
  @@map("external_links")
}

model WorkCalendar {
  id                         Int               @id @default(autoincrement())
  name                       String            @unique @db.VarChar(128)
  calendarYear               Int               @map("calendar_year")
  countryCode                String            @default("JP") @map("country_code") @db.VarChar(2)
  scheduledWorkMinutesPerDay Int               @default(465) @map("scheduled_work_minutes_per_day")
  description                String?           @db.VarChar(1000)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?         @map("deleted_at") @db.Timestamptz(3)
  employees                  Employee[]
  entries                    WorkCalendarDay[]

  @@index([calendarYear])
  @@map("work_calendars")
}

model WorkCalendarDay {
  id         Int          @id @default(autoincrement())
  calendarId Int          @map("calendar_id")
  workDate   DateTime     @map("work_date") @db.Date
  entryType  String       @default("working_day") @map("entry_type") @db.VarChar(32)
  title      String       @db.VarChar(128)
  note       String?      @db.VarChar(5000)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(3)
  calendar   WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)

  @@unique([calendarId, workDate])
  @@index([calendarId])
  @@map("work_calendar_days")
}

model CalendarDateAttribute {
  id           Int       @id @default(autoincrement())
  calendarDate DateTime  @map("calendar_date") @db.Date
  countryCode  String    @default("JP") @map("country_code") @db.VarChar(2)
  kind         String    @db.VarChar(32)
  name         String    @db.VarChar(128)
  source       String    @db.VarChar(32)
  sourceUrl    String?   @map("source_url") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([countryCode, calendarDate, kind])
  @@index([calendarDate])
  @@map("calendar_date_attributes")
}

model CalendarHolidayImport {
  id            Int       @id @default(autoincrement())
  importKey     String    @unique @default(dbgenerated("gen_random_uuid()")) @map("import_key") @db.Uuid
  countryCode   String    @default("JP") @map("country_code") @db.VarChar(2)
  sourceUrl     String    @map("source_url") @db.VarChar(500)
  rangeStart    DateTime? @map("range_start") @db.Date
  rangeEnd      DateTime? @map("range_end") @db.Date
  importedCount Int       @default(0) @map("imported_count")
  status        String    @db.VarChar(20)
  errorMessage  String?   @map("error_message") @db.VarChar(500)
  completedAt   DateTime  @default(now()) @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([completedAt])
  @@index([countryCode, completedAt])
  @@map("calendar_holiday_imports")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  defaultKey  String?          @unique @map("default_key")
  notes       String?          @db.VarChar(5000)
  sortOrder   Int              @default(2147483647) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(3)
  grants      EmployeeRole[]
  permissions RolePermission[]

  @@index([sortOrder, name])
  @@map("roles")
}

model Permission {
  id         Int                   @id @default(autoincrement())
  identifier String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String                @unique
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?             @map("deleted_at") @db.Timestamptz(3)
  roles      RolePermission[]
  operations PermissionOperation[]

  @@map("permissions")
}

model PermissionOperation {
  id           Int        @id @default(autoincrement())
  operation    String     @unique
  permissionId Int        @unique @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@index([permissionId])
  @@map("permission_operations")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  scopeType    String     @default("global") @map("scope_type")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  id              Int         @id @default(autoincrement())
  employeeId      Int         @map("employee_id")
  roleId          Int         @map("role_id")
  scopeType       String      @default("global") @map("scope_type")
  scopeKey        String      @default("global") @map("scope_key")
  departmentId    Int?        @map("department_id")
  scopeEmployeeId Int?        @map("scope_employee_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)
  employee        Employee    @relation("Grantee", fields: [employeeId], references: [id], onDelete: Restrict)
  role            Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  scopeEmployee   Employee?   @relation("ScopeEmployee", fields: [scopeEmployeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, roleId, scopeType, scopeKey])
  @@index([roleId])
  @@index([departmentId])
  @@index([scopeEmployeeId])
  @@map("employee_roles")
}

model Department {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  notes               String?              @db.VarChar(5000)
  sortOrder           Int                  @default(9999) @map("sort_order")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  employeeAssignments EmployeeDepartment[]
  groups              EmployeeGroup[]
  roleGrants          EmployeeRole[]

  @@map("employment_departments")
}

model EmployeeDepartment {
  id           Int        @id @default(autoincrement())
  employeeId   Int        @map("employee_id")
  departmentId Int        @map("department_id")
  isPrimary    Boolean    @default(false) @map("is_primary")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([employeeId, departmentId])
  @@index([departmentId])
  @@map("employee_departments")
}

model Skill {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(128)
  nameKey     String          @unique @map("name_key") @db.VarChar(128)
  category    String?         @db.VarChar(128)
  description String?         @db.VarChar(5000)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)
  employees   EmployeeSkill[]

  @@map("skills")
}

model Client {
  id                      Int       @id @default(autoincrement())
  name                    String    @unique @db.VarChar(128)
  countryCode             String    @default("JP") @map("country_code") @db.VarChar(2)
  postalCode              String?   @map("postal_code") @db.VarChar(10)
  prefecture              String?   @db.VarChar(64)
  city                    String?   @db.VarChar(128)
  streetAddress           String?   @map("street_address") @db.VarChar(255)
  buildingName            String?   @map("building_name") @db.VarChar(255)
  phoneNumber1            String?   @map("phone_number_1") @db.VarChar(32)
  phoneNumber2            String?   @map("phone_number_2") @db.VarChar(32)
  faxNumber1              String?   @map("fax_number_1") @db.VarChar(32)
  faxNumber2              String?   @map("fax_number_2") @db.VarChar(32)
  notes                   String?
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(3)
  companyName             String    @map("company_name") @db.VarChar(128)
  contactName             String?   @map("contact_name") @db.VarChar(128)
  contactDepartment       String?   @map("contact_department") @db.VarChar(128)
  contactEmail            String?   @map("contact_email") @db.VarChar(254)
  contactMobile           String?   @map("contact_mobile") @db.VarChar(32)
  projects                Project[]

  @@map("clients")
}

model Project {
  clientId Int? @map("client_id")
  contractStartsOn DateTime? @map("contract_starts_on") @db.Date
  contractEndsOn DateTime? @map("contract_ends_on") @db.Date
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  id             Int                    @id @default(autoincrement())
  code           String                 @unique @default(dbgenerated("('PRJ-'::text || (nextval('project_code_seq'::regclass))::text)")) @db.VarChar(64)
  name           String                 @db.VarChar(128)
  description    String?                @db.VarChar(5000)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?              @map("deleted_at") @db.Timestamptz(3)
  participations ProjectParticipation[]

  @@index([clientId])
  @@map("projects")
}

model EmployeeSkill {
  id              Int       @id @default(autoincrement())
  employeeId      Int       @map("employee_id")
  skillId         Int       @map("skill_id")
  proficiency     Int       @db.SmallInt
  experienceYears Decimal?  @map("experience_years") @db.Decimal(3, 1)
  notes           String?   @db.VarChar(5000)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([employeeId, skillId])
  @@index([skillId])
  @@map("employee_skills")
}

model ProjectParticipation {
  id             Int       @id @default(autoincrement())
  employeeId     Int       @map("employee_id")
  projectId      Int       @map("project_id")
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  responsibility String?   @db.VarChar(5000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([employeeId, projectId, startsOn])
  @@index([projectId, endsOn])
  @@map("project_participations")
}

model WorkforceChangeHistory {
  id         Int       @id @default(autoincrement())
  eventKey   String    @unique @default(dbgenerated("gen_random_uuid()")) @map("event_key") @db.Uuid
  employeeId Int       @map("employee_id")
  actorId    Int       @map("actor_id")
  resource   String    @db.VarChar(40)
  resourceId Int       @map("resource_id")
  action     String    @db.VarChar(20)
  changes    Json
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  employee   Employee  @relation("WorkforceSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  actor      Employee  @relation("WorkforceActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt])
  @@map("workforce_change_history")
}

model Team {
  id          Int            @id @default(autoincrement())
  code        String         @unique @default(dbgenerated("('TEAM-'::text || (nextval('team_code_seq'::regclass))::text)")) @db.VarChar(64)
  /// Migration m0031 enforces case-insensitive, trimmed uniqueness for active team names.
  name        String         @db.VarChar(128)
  description String?        @db.VarChar(5000)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)
  members     EmployeeTeam[]

  @@map("teams")
}

model EmployeeTeam {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  teamId     Int      @map("team_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([employeeId, teamId])
  @@index([teamId])
  @@map("employee_teams")
}

model EmployeeGroup {
  id           Int         @id @default(autoincrement())
  departmentId Int?        @map("department_id")
  name         String
  notes        String?     @db.VarChar(5000)
  sortOrder    Int         @default(9999) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees    Employee[]

  @@unique([departmentId, name])
  @@map("employee_groups")
}

model Position {
  id                  Int                @id @default(autoincrement())
  name                String             @unique
  notes               String?            @db.VarChar(5000)
  sortOrder           Int                @default(9999) @map("sort_order")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
