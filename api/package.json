{
	"name": "equipment-api",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5174",
		"build": "prisma generate && vite build",
		"start": "node build",
		"prepare": "svelte-kit sync && prisma generate",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"admin:create": "node scripts/create-admin.mjs",
		"db:verify": "node scripts/verify-database.mjs",
		"api:verify": "node scripts/verify-api.mjs",
		"check": "svelte-kit sync && prisma generate && tsc --noEmit"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.3.2",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"prisma": "^7.10.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"pg": "^8.16.3"
	}
}
