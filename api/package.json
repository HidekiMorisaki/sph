{
	"name": "equipment-api",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5174",
		"build": "prisma generate && vite build",
		"start": "node build",
		"prepare": "svelte-kit sync && prisma generate && node scripts/prepare-book-samples.mjs",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"admin:create": "node scripts/create-admin.mjs",
		"db:baseline": "node scripts/baseline-existing.mjs",
		"check": "svelte-kit sync && prisma generate && tsc --noEmit && node scripts/prepare-book-samples.mjs --check"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.3.2",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"prisma": "^7.10.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "7.3.7"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"jpeg-js": "0.4.4",
		"pg": "^8.23.1",
		"pngjs": "7.0.0"
	},
	"overrides": {
		"deepmerge-ts": "8.0.2",
		"mysql2": "3.24.6",
		"@sveltejs/kit": {
			"cookie": "0.7.2"
		}
	}
}
